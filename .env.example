# Template only. Run python scripts/configure.py to generate random local secrets.
AIRFLOW_UID=50000
POSTGRES_PASSWORD=
AIRFLOW_FERNET_KEY=
AIRFLOW_WEBSERVER_SECRET_KEY=
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=
MINIO_ROOT_USER=rutanova_admin
MINIO_ROOT_PASSWORD=
MINIO_ACCESS_KEY=rutanova_pipeline
MINIO_SECRET_KEY=
SNOWFLAKE_ACCOUNT=REPLACE_ORG-ACCOUNT
SNOWFLAKE_USER=RUTANOVA_SVC
SNOWFLAKE_ROLE=RUTANOVA_ROLE
SNOWFLAKE_DATABASE=RUTANOVA
